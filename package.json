    "@privy-io/react-auth": "3.6.1",
    "@solana-program/memo": "0.8.0",
    "@solana-program/system": "0.8.0",
    "@solana-program/token": "0.6.0",
    "@solana/kit": "3.0.3",
    "buffer": "6.0.3",
    "drizzle-orm": "0.45.2",
    "jose": "4.15.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "viem": "2.55.10"
